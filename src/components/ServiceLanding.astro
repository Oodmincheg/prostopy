---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Button from './Button.astro';
import SectionTitle from './SectionTitle.astro';
import '../styles/global.css';

export interface PriceRow {
  name: string;
  time?: string;
  price: string;
}

export interface PriceGroup {
  title?: string;
  rows: PriceRow[];
}

export interface PhotoPair {
  before: ImageMetadata;
  after: ImageMetadata;
  label: string;
}

export interface PhotoExtra {
  img: ImageMetadata;
  caption: string;
}

export interface Step {
  title: string;
  desc: string;
}

export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  fromPrice: string;
  symptomsTitle: string;
  symptoms: string[];
  symptomsNote?: string;
  steps: Step[];
  priceGroups: PriceGroup[];
  priceNote?: string;
  pairs: PhotoPair[];
  extras?: PhotoExtra[];
  faq: FaqItem[];
  ctaText?: string;
  jsonLd: Record<string, unknown>;
}

const {
  title,
  description,
  h1,
  intro,
  fromPrice,
  symptomsTitle,
  symptoms,
  symptomsNote,
  steps,
  priceGroups,
  priceNote,
  pairs,
  extras = [],
  faq,
  ctaText = 'Надішліть нам фото проблеми в Instagram — підкажемо, яка саме процедура вам потрібна.',
  jsonLd,
} = Astro.props;

const PHONE_HREF = 'tel:+380985279475';
const PHONE_TEXT = '+380 98 527 94 75';
const INSTAGRAM_HREF = 'https://www.instagram.com/podolog_datsyshyna';
---

<Layout title={title} description={description} ukOnly>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <section class="gradient-hero py-16 md:py-20 px-4">
    <div class="container-custom max-w-4xl text-center">
      <p class="inline-block bg-white/70 rounded-full px-5 py-1.5 text-sm font-medium text-dark mb-6">
        {fromPrice} · Позняки / Осокорки
      </p>
      <h1 class="text-3xl md:text-5xl font-prosto text-dark mb-6 text-balance">{h1}</h1>
      <p class="text-lg md:text-xl text-gray mb-8 max-w-2xl mx-auto">{intro}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={PHONE_HREF} size="lg">Подзвонити · {PHONE_TEXT}</Button>
        <Button href={INSTAGRAM_HREF} variant="secondary" size="lg" target="_blank" rel="noopener noreferrer">
          Написати в Instagram
        </Button>
      </div>
    </div>
  </section>

  <!-- Before / After -->
  <section class="section-padding bg-base-6/10">
    <div class="container-custom max-w-4xl">
      <SectionTitle title="Результати роботи" class="mb-12" />
      <div class="space-y-12">
        {pairs.map((pair, i) => (
          <figure>
            <input type="checkbox" id={`pair-reveal-${i}`} class="reveal-toggle" hidden />
            <div class="pair-grid">
              <div class="pair-before relative">
                <Image src={pair.before} alt={`${pair.label} — до процедури`} class="rounded-2xl w-full h-full object-cover aspect-[3/4]" widths={[400, 800]} sizes="(max-width: 768px) 50vw, 400px" />
                <span class="absolute top-3 left-3 bg-dark/80 text-white text-xs font-medium px-3 py-1 rounded-full">До</span>
              </div>
              <div class="relative">
                <Image src={pair.after} alt={`${pair.label} — після процедури`} class="rounded-2xl w-full h-full object-cover aspect-[3/4]" widths={[400, 800]} sizes="(max-width: 768px) 90vw, 400px" />
                <span class="absolute top-3 left-3 bg-accent text-dark text-xs font-medium px-3 py-1 rounded-full">Після</span>
              </div>
            </div>
            <div class="reveal-controls mt-4 text-center">
              <label for={`pair-reveal-${i}`} class="inline-flex items-center gap-2 cursor-pointer text-dark font-medium underline decoration-accent decoration-2 underline-offset-4 hover:decoration-base-4">
                <span class="label-show">Показати фото до процедури</span>
                <span class="label-hide">Сховати фото до процедури</span>
              </label>
            </div>
            <figcaption class="text-gray text-sm mt-3 text-center">{pair.label}</figcaption>
          </figure>
        ))}
        {extras.length > 0 && (
          <div class="grid grid-cols-2 gap-4">
            {extras.map((extra) => (
              <figure>
                <Image src={extra.img} alt={extra.caption} class="rounded-2xl w-full object-cover aspect-[3/4]" widths={[400, 800]} sizes="(max-width: 768px) 50vw, 400px" />
                <figcaption class="text-gray text-sm mt-3 text-center">{extra.caption}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
      <p class="text-gray text-xs mt-8 text-center">Фото опубліковано за згодою клієнтів.</p>
    </div>
  </section>

  <!-- Symptoms -->
  <section class="section-padding bg-white">
    <div class="container-custom max-w-4xl">
      <SectionTitle title={symptomsTitle} class="mb-10" />
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {symptoms.map((s) => (
          <li class="flex items-start gap-3 bg-base-6/10 rounded-xl p-4">
            <svg class="w-6 h-6 text-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{s}</span>
          </li>
        ))}
      </ul>
      {symptomsNote && (
        <div class="mt-6 flex items-start gap-3 bg-base-3/20 border border-base-3/50 rounded-xl p-4">
          <svg class="w-6 h-6 text-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
          <p class="text-dark text-sm leading-relaxed">{symptomsNote}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Steps -->
  <section class="section-padding bg-base-6/10">
    <div class="container-custom max-w-4xl">
      <SectionTitle title="Як проходить процедура" class="mb-12" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {steps.map((step, i) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm">
            <div class="w-10 h-10 bg-accent rounded-full flex items-center justify-center font-prosto text-dark mb-4">
              {i + 1}
            </div>
            <h3 class="text-lg font-prosto text-dark mb-2">{step.title}</h3>
            <p class="text-gray text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Prices -->
  <section class="section-padding bg-white">
    <div class="container-custom max-w-4xl">
      <SectionTitle title="Ціни" class="mb-10" />
      <div class="space-y-10">
        {priceGroups.map((group) => (
          <div>
            {group.title && <h3 class="text-xl font-prosto text-dark mb-4">{group.title}</h3>}
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-base-6/60 text-gray text-sm">
                    <th class="py-3 pr-4 font-medium">Послуга</th>
                    <th class="py-3 pr-4 font-medium whitespace-nowrap">Тривалість</th>
                    <th class="py-3 font-medium whitespace-nowrap">Ціна</th>
                  </tr>
                </thead>
                <tbody>
                  {group.rows.map((row) => (
                    <tr class="border-b border-base-6/30">
                      <td class="py-3 pr-4">{row.name}</td>
                      <td class="py-3 pr-4 text-gray whitespace-nowrap">{row.time ?? '—'}</td>
                      <td class="py-3 font-medium whitespace-nowrap">{row.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
      {priceNote && <p class="text-gray text-sm mt-6">{priceNote}</p>}
    </div>
  </section>

  <!-- Trust -->
  <section class="section-padding bg-base-6/10">
    <div class="container-custom max-w-4xl">
      <SectionTitle title="Чому нам довіряють" class="mb-12" />
      <div class="grid grid-cols-3 gap-4 mb-10 text-center">
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <div class="text-2xl md:text-3xl font-prosto text-dark mb-1">1000+</div>
          <div class="text-gray text-sm">клієнтів</div>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <div class="text-2xl md:text-3xl font-prosto text-dark mb-1">4.8</div>
          <div class="text-gray text-sm">рейтинг у Google</div>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <div class="text-2xl md:text-3xl font-prosto text-dark mb-1">100%</div>
          <div class="text-gray text-sm">стерильність</div>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <h3 class="text-lg font-prosto text-dark mb-2">Стерильність та безпека</h3>
          <p class="text-gray text-sm leading-relaxed">
            Всі інструменти проходять повний цикл стерилізації. Одноразові матеріали для кожного клієнта.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <h3 class="text-lg font-prosto text-dark mb-2">Сучасне обладнання</h3>
          <p class="text-gray text-sm leading-relaxed">
            Працюємо на професійному обладнанні європейських виробників. Тільки перевірені засоби та матеріали.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding bg-white">
    <div class="container-custom max-w-3xl">
      <SectionTitle title="Часті питання" class="mb-10" />
      <div class="space-y-4">
        {faq.map((item) => (
          <details class="group bg-white rounded-2xl shadow-sm">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-5 font-medium text-dark">
              {item.q}
              <svg class="w-5 h-5 text-gray flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <p class="px-5 pb-5 text-gray leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-padding bg-dark text-white">
    <div class="container-custom max-w-3xl text-center">
      <h2 class="text-2xl md:text-3xl font-prosto mb-4">Запишіться на прийом</h2>
      <p class="text-gray-300 mb-8">{ctaText}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <Button href={PHONE_HREF} size="lg">Подзвонити · {PHONE_TEXT}</Button>
        <Button href={INSTAGRAM_HREF} size="lg" class="!border-white/40 !text-white hover:!bg-white/10" variant="secondary" target="_blank" rel="noopener noreferrer">
          Написати в Instagram
        </Button>
      </div>
      <p class="text-gray-300">
        <a href="https://maps.app.goo.gl/76fG8wXxRjPa4WVB8" target="_blank" rel="noopener noreferrer" class="underline decoration-accent decoration-2 underline-offset-4 hover:text-white">
          ЖК Seven, Дніпровська набережна, 20а, Київ
        </a>
        · р-н Позняки / Осокорки
      </p>
    </div>
  </section>
</Layout>
