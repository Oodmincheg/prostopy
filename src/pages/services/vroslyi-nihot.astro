---
import ServiceLanding from '../../components/ServiceLanding.astro';
import beforeImg from '../../assets/services/vroslyi-do.jpg';
import afterImg from '../../assets/services/vroslyi-pislia.jpg';
import systema1 from '../../assets/services/vroslyi-systema-1.jpg';
import systema2 from '../../assets/services/vroslyi-systema-2.jpg';
---

<ServiceLanding
  title="Врослий ніготь — корекція без операції у Києві | PRO STOPY"
  description="Корекція врослого нігтя без болю та хірургії: обробка, корекційні системи, протезування. Подолог у Києві, Позняки/Осокорки. Від 650 грн."
  h1="Врослий ніготь? Виправимо без операції"
  intro="Делікатна обробка врослої ділянки: знімаємо біль за один візит і виправляємо ріст нігтя корекційними системами — без хірургічного втручання."
  fromPrice="від 650 грн"
  symptomsTitle="Коли варто прийти"
  symptoms={[
    'Біль при ходьбі або в закритому взутті',
    'Почервонів чи набряк валик збоку нігтя',
    'Край нігтя ріже шкіру, ранка не гоїться',
    'З’явилися виділення або розрослася тканина',
    'Ніготь вростає знову після зрізання куточка',
  ]}
  steps={[
    { title: 'Огляд', desc: 'Оцінюємо стадію вростання, запалення та форму нігтя, пояснюємо тактику й ціну до початку роботи.' },
    { title: 'Перший візит', desc: 'Делікатна резекція врослої ділянки та встановлення стерильної тампонади. Біль суттєво зменшується вже після першого візиту.' },
    { title: 'Загоювання вдома', desc: 'Травмовані тканини загоюються вдома за нашими рекомендаціями; за потреби приходите на заміну тампонади.' },
    { title: 'Корекційна система', desc: 'Наступним етапом за потреби встановлюємо титанову нитку або систему ЗТО — з урахуванням положення стопи та деформацій.' },
  ]}
  priceGroups={[
    {
      title: 'Обробка врослого нігтя',
      rows: [
        { name: 'Без запалення, 1 ніготь', time: '15–20 хв', price: '650 грн' },
        { name: 'Без запалення, 2 нігті', time: '15–20 хв', price: '800 грн' },
        { name: 'Із запаленням, 1 ніготь', time: '30–45 хв', price: '800–1000 грн' },
        { name: 'Із запаленням, 2 нігті', time: '30–45 хв', price: '1200–1400 грн' },
        { name: 'З гіпергрануляцією, 1 ніготь', time: '45–60 хв', price: '1400–1600 грн' },
        { name: 'З гіпергрануляцією, 2 нігті', time: '45–60 хв', price: '2200 грн' },
      ],
    },
    {
      title: 'Корекційні системи',
      rows: [
        { name: 'Встановлення титанової нитки', time: '30 хв', price: '1000 грн' },
        { name: 'Встановлення системи ЗТО', time: '45–60 хв', price: '1600–1800 грн' },
        { name: 'Планова корекція системи ЗТО', time: '30 хв', price: '1200 грн' },
      ],
    },
    {
      title: 'Повторні візити та профілактика',
      rows: [
        { name: 'Повторний візит (заміна тампонади)', time: '10 хв', price: '300 грн' },
        { name: 'Повторний візит після гіпергрануляції', time: '25–30 хв', price: '600–800 грн' },
        { name: 'Профілактика врослого нігтя', time: '15–20 хв', price: '450 грн' },
      ],
    },
    {
      title: 'Протезування нігтя',
      rows: [
        { name: 'Невеличка ділянка (куточки)', time: '10 хв', price: '400 грн' },
        { name: 'Весь ніготь', time: '25–30 хв', price: '800–1000 грн' },
        { name: 'Протезування з вкладками', time: '25–30 хв', price: '1000–1200 грн' },
      ],
    },
  ]}
  priceNote="Вибір корекційної системи залежить від рівня та типу скрученості нігтя і визначається подологом під час прийому."
  pairs={[
    { before: beforeImg, after: afterImg, label: 'Врослий ніготь із запаленням — палець після обробки' },
  ]}
  extras={[
    { img: systema1, caption: 'Титанова нитка м’яко вирівнює ріст нігтя' },
    { img: systema2, caption: 'Корекційна система для складних деформацій' },
  ]}
  faq={[
    {
      q: 'Це боляче?',
      a: 'Обробка максимально щадна: працюємо апаратно, без розрізів. При сильному запаленні можливий дискомфорт, але вже після першого візиту біль суттєво зменшується.',
    },
    {
      q: 'Ніготь треба видаляти?',
      a: 'Ні. Хірургічне видалення не потрібне: врослий край звільняється, а корекційні системи поступово виправляють форму нігтя, щоб вростання не повторювалося.',
    },
    {
      q: 'Скільки візитів знадобиться?',
      a: 'Без запалення часто досить одного візиту плюс профілактика. Якщо встановлюється корекційна система, вона носиться кілька місяців із плановими корекціями раз на 3–6 тижнів.',
    },
    {
      q: 'Що буде, якщо не лікувати?',
      a: 'Вростання саме не минає: запалення посилюється, наростає гіпергрануляція («дике м’ясо»), і корекція стає довшою й дорожчою. Чим раніше прийти, тим простіше все виправити.',
    },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Корекція врослого нігтя',
    serviceType: 'Ingrown toenail correction',
    provider: { '@id': 'https://prostopy.com/#business' },
    areaServed: { '@type': 'City', name: 'Kyiv' },
    offers: { '@type': 'AggregateOffer', priceCurrency: 'UAH', lowPrice: '300', highPrice: '2200' },
  }}
/>
